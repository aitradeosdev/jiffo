@@ -32,10 +32,17 @@ class DrizzleError extends Error {
     this.cause = cause;
   }
 }
+// The database's reason for a failed query, without the values sent with it. A data exception (SQLSTATE class
+// 22, such as invalid input syntax) quotes the value it couldn't read, so only its code is given.
+function queryErrorReason(cause) {
+  if (!cause) return "Failed query";
+  const code = typeof cause.code === "string" ? cause.code : "";
+  return code.startsWith("22") ? `invalid value (${code})` : cause.message;
+}
 class DrizzleQueryError extends Error {
   constructor(query, params, cause) {
-    super(`Failed query: ${query}
-params: ${params}`);
+    super(`${queryErrorReason(cause)}
+query: ${query}`);
     this.query = query;
     this.params = params;
     this.cause = cause;
