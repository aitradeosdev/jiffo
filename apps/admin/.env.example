# Where the admin API is, as the panel's server reaches it: the API's ADMIN_API_PORT when that is set
# (always in production), otherwise its PORT.
API_URL=http://localhost:3000
# The same value as ADMIN_PANEL_SECRET in the API's environment. Required in production.
ADMIN_PANEL_SECRET=
# Load balancers in front of the panel, so the admin's own IP address is read correctly. Required in production.
TRUST_PROXY_HOPS=0
