{
  "name": "@jiffo/api",
  "version": "0.1.0",
  "private": true,
  "description": "Jiffo backend: accounts, country settings, errands, chat and push",
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "dev": "nest start --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "openapi": "UPDATE_OPENAPI=1 vitest run test/api-inventory.e2e.test.ts",
    "check:injection": "node scripts/check-injection.cjs dist",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node dist/db/migrate-cli.js",
    "admin": "node dist/admin/admin-cli.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1168.0",
    "@aws-sdk/client-sesv2": "^3.1168.0",
    "@aws-sdk/s3-request-presigner": "^3.1168.0",
    "@jiffo/shared": "workspace:*",
    "@nestjs/common": "^11.2.10",
    "@nestjs/core": "^11.2.10",
    "@nestjs/platform-express": "^11.2.10",
    "@nestjs/platform-socket.io": "^11.2.10",
    "@nestjs/websockets": "^11.2.10",
    "@socket.io/redis-adapter": "8.3.0",
    "bullmq": "^5.81.5",
    "drizzle-orm": "~0.36.4",
    "ioredis": "^5.11.1",
    "jose": "^5.10.0",
    "libphonenumber-js": "^1.13.16",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/testing": "^11.2.10",
    "@swc/core": "^1.16.22",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^6.0.3",
    "drizzle-kit": "~0.28.1",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.3.2",
    "typescript": "~5.7.3",
    "unplugin-swc": "^1.6.0",
    "vitest": "^3.2.6"
  }
}
