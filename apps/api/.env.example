# Copy to apps/api/.env for local development. Never commit real secrets.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://jiffo:jiffo@localhost:5432/jiffo
REDIS_URL=redis://localhost:6379
RUN_MIGRATIONS=true

# Generate each with: openssl rand -hex 32
JWT_SECRET=
OTP_SECRET=
PIN_KEY=
# Production also needs one key per job, each different (openssl rand -hex 32; the last: 32+ characters).
# In development they are derived from PIN_KEY. Changing one makes what it protects unreadable, so a
# deployment that already has data sets the first three to what `pnpm admin derived-keys` prints.
# ID_FINGERPRINT_KEY=
# ADMIN_TOTP_KEY=
# FIELD_KEY=
# ADMIN_TOKEN_SECRET=

ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
DEFAULT_COUNTRY=NG
OTP_PER_IP_PER_HOUR=30
# Number of load balancers in front of the API: 0 locally. Required in production.
TRUST_PROXY_HOPS=0
CORS_ORIGINS=*
# The admin panel's address, for invite links. Required in production.
ADMIN_URL=http://localhost:3001
# Shared with the admin panel (its ADMIN_PANEL_SECRET), so it can pass on the admin's own IP. openssl rand -hex 32. Required in production.
ADMIN_PANEL_SECRET=

# console prints codes and pushes to the log. Production needs termii and fcm.
MESSAGING_PROVIDER=console
TERMII_API_KEY=
TERMII_SENDER_ID=
TERMII_BASE_URL=https://api.ng.termii.com

PUSH_PROVIDER=console
# The Firebase service account key, as one line of JSON.
FCM_SERVICE_ACCOUNT_JSON=

# fake gives every top-up a test account number and pays nothing out. Production needs paystack.
PAYMENTS_PROVIDER=fake
PAYSTACK_SECRET_KEY=
PAYSTACK_BASE_URL=https://api.paystack.co
FAKE_PAYMENTS_SECRET=fake-payments-secret
# With the fake provider, top-ups land by themselves after this many seconds (0 = never).
FAKE_PAYMENTS_AUTOPAY_SECONDS=10
PAYMENT_EMAIL_DOMAIN=customers.jiffoapp.com
# UTC. 15:00 UTC is 16:00 in Lagos.
PAYOUT_CRON=0 15 * * *
RECONCILE_CRON=30 23 * * *
PAYOUT_RETRY_CRON=*/5 * * * *

# fake knows a few Lagos places; production needs google and a key with Places and Routes enabled.
MAPS_PROVIDER=fake
GOOGLE_MAPS_API_KEY=

# memory keeps uploaded photos in the API process (development only). Production needs s3.
STORAGE_PROVIDER=memory
S3_BUCKET=
S3_REGION=af-south-1
S3_ENDPOINT=
PUBLIC_API_URL=http://localhost:3000

CHAT_PROVIDER=builtin
TIMER_PROVIDER=bullmq

# Optional: requests a minute per class of route, over the defaults (common/rate-limit.ts).
# RATE_LIMITS=paid=30,auth=30
# Optional: only take Paystack's webhooks from these addresses (Paystack lists them in its docs).
# PAYSTACK_WEBHOOK_IPS=
