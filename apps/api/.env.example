# Copy to apps/api/.env for local development. Never commit real secrets.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://jiffo:jiffo@localhost:5432/jiffo
REDIS_URL=redis://localhost:6379
RUN_MIGRATIONS=true

# Generate each with: openssl rand -hex 32
JWT_SECRET=
OTP_SECRET=
PIN_KEY=

ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
DEFAULT_COUNTRY=NG
OTP_PER_IP_PER_HOUR=30
# Number of load balancers in front of the API: 0 locally. Required in production.
TRUST_PROXY_HOPS=0
CORS_ORIGINS=*

# console prints codes and pushes to the log. Production needs termii and fcm.
MESSAGING_PROVIDER=console
TERMII_API_KEY=
TERMII_SENDER_ID=
TERMII_BASE_URL=https://api.ng.termii.com

PUSH_PROVIDER=console
# The Firebase service account key, as one line of JSON.
FCM_SERVICE_ACCOUNT_JSON=

# fake gives every top-up a test account number and pays nothing out. Production needs paystack.
PAYMENTS_PROVIDER=fake
PAYSTACK_SECRET_KEY=
PAYSTACK_BASE_URL=https://api.paystack.co
FAKE_PAYMENTS_SECRET=fake-payments-secret
PAYMENT_EMAIL_DOMAIN=customers.jiffo.app
# UTC. 15:00 UTC is 16:00 in Lagos.
PAYOUT_CRON=0 15 * * *
RECONCILE_CRON=30 23 * * *
PAYOUT_RETRY_CRON=*/5 * * * *

CHAT_PROVIDER=builtin
TIMER_PROVIDER=bullmq
