# The only way in from the internet (docs/deploy.md): HTTPS for the API and the admin panel, with certificates
# Caddy gets and renews on its own. The admin API's port is never proxied: only the panel reaches it, inside.
{
	email {$ACME_EMAIL}
}

{$API_HOST} {
	encode zstd gzip
	reverse_proxy api:3000
}

{$ADMIN_HOST} {
	encode zstd gzip
	reverse_proxy admin:3001
}
